# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.

# Database MariaDB/MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pap_absensi
DB_USER=pap_absensi
DB_PASSWORD=

# Rahasia penandatangan sesi (min. 32 karakter acak). Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# Folder penyimpanan foto absensi (di luar folder publik)
UPLOAD_DIR=/var/lib/pap-absensi/photos

# Admin awal (dipakai sekali oleh `pnpm db:migrate` bila belum ada admin)
SEED_ADMIN_NIK=admin
SEED_ADMIN_NAME=Administrator HR
SEED_ADMIN_PASSWORD=

# reCAPTCHA v3 (login). Kosongkan untuk menonaktifkan di pengembangan lokal.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTS=absensi.pandawaamerta.co.id
RECAPTCHA_MIN_SCORE=0.5
